# Option A: Vertex AI (recommended in Google Cloud / Qwiklabs environment)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Option B: Gemini Developer API Key (if testing locally without Vertex AI)
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GOOGLE_API_KEY=your-api-key

# Optional overrides
BIGQUERY_DATASET=a4i_food
EMBED_ENDPOINT=gemini-embedding-2
ADK_MODEL=gemini-2.5-flash

# Managed BigQuery / MCP Toolset Configuration
ENABLE_BIGQUERY_TOOLSET=TRUE
# Optional remote MCP Toolbox URL (e.g., Cloud Run MCP Toolbox serving agent/tools.yaml or https://bigquery.googleapis.com/mcp)
# MCP_TOOLBOX_URL=http://127.0.0.1:5000/mcp


